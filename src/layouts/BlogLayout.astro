---
import Layout from './Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { withBase } from '../lib/assetPath';

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  date: string;
  readTime: string;
  image: string;
  imageAlt: string;
}

const { title, description, eyebrow, date, readTime, image, imageAlt } = Astro.props;
---

<Layout title={`${title} | Robert Lech`} description={description} ogImage={image}>
  <div class="web-only">
    <Header />
    <main id="main-content" class="blog-shell">
      <article class="blog-article">
        <a href="/#portfolio" class="back-link">Back to writing</a>
        <header class="blog-header">
          <p class="blog-eyebrow">{eyebrow}</p>
          <h1>{title}</h1>
          <p class="blog-description">{description}</p>
          <p class="blog-meta">By Robert Lech · {date} · {readTime}</p>
        </header>

        <figure class="blog-banner">
          <img src={withBase(image)} alt={imageAlt} width="1200" height="675" />
        </figure>

        <div class="blog-content">
          <slot />
        </div>
      </article>
    </main>
    <Footer />
  </div>
</Layout>

<style>
  .blog-shell {
    min-height: 100vh;
    padding: 7rem 1rem 5rem;
    background:
      linear-gradient(180deg, rgba(15, 23, 42, 0.72), rgba(2, 6, 23, 0.96)),
      var(--bg);
  }

  .blog-article {
    width: min(100%, 880px);
    margin: 0 auto;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    margin-bottom: 2rem;
    color: var(--accent);
    font-size: 0.9rem;
    font-weight: 700;
    text-decoration: none;
  }

  .back-link:hover {
    color: var(--highlight);
  }

  .blog-header {
    margin-bottom: 2rem;
  }

  .blog-eyebrow {
    margin-bottom: 0.85rem;
    color: var(--accent);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .blog-header h1 {
    margin: 0;
    color: var(--text);
    font-size: clamp(2.4rem, 7vw, 4.5rem);
    line-height: 1;
  }

  .blog-description {
    max-width: 780px;
    margin: 1.25rem 0 0;
    color: var(--text-muted);
    font-size: 1.1rem;
    line-height: 1.75;
  }

  .blog-meta {
    margin-top: 1rem;
    color: #94a3b8;
    font-size: 0.92rem;
  }

  .blog-banner {
    margin: 2.25rem 0 3rem;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    background: var(--bg-card);
  }

  .blog-banner img {
    display: block;
    width: 100%;
    height: auto;
  }

  .blog-content {
    color: var(--text-muted);
    font-size: 1.05rem;
    line-height: 1.8;
  }

  .blog-content :global(h2) {
    margin: 3rem 0 1rem;
    color: var(--text);
    font-size: clamp(1.7rem, 4vw, 2.25rem);
    line-height: 1.16;
  }

  .blog-content :global(h3) {
    margin: 2.2rem 0 0.8rem;
    color: var(--text);
    font-size: 1.35rem;
  }

  .blog-content :global(p),
  .blog-content :global(ul),
  .blog-content :global(ol),
  .blog-content :global(pre) {
    margin: 1rem 0;
  }

  .blog-content :global(ul),
  .blog-content :global(ol) {
    padding-left: 1.35rem;
  }

  .blog-content :global(li) {
    margin: 0.45rem 0;
  }

  .blog-content :global(a) {
    color: var(--accent);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .blog-content :global(code) {
    border: 1px solid var(--border);
    border-radius: 0.25rem;
    padding: 0.1rem 0.3rem;
    background: rgba(15, 23, 42, 0.75);
    color: #dbeafe;
    font-size: 0.92em;
  }

  .blog-content :global(pre) {
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    padding: 1rem;
    background: #020617;
  }

  .blog-content :global(pre code) {
    border: 0;
    padding: 0;
    background: transparent;
  }

  .blog-content :global(.blog-banner) {
    margin: 2rem 0;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    background: var(--bg-card);
  }

  .blog-content :global(.blog-banner img) {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
