---
import personalData from '../data/personal.json';
import { getSocialLinks } from '../lib/socialLinks';

const heroSocialLinks = getSocialLinks(
  personalData as unknown as Record<string, string | string[]>,
  personalData.heroSocialLinks
);

import { withBase } from '../lib/assetPath';

// Split "Frontend & Backend" so the "&" can be styled with a different colour in the template.
const heroParts = personalData.heroRole.split(' & ');
---

<section id="home" class="relative min-h-screen overflow-hidden flex items-center">
  <div class="spotlight-bg" aria-hidden="true">
    <div class="spotlight spotlight-1"></div>
    <div class="spotlight spotlight-2"></div>
    <div class="spotlight spotlight-3"></div>
  </div>

  <div class="hero-shell container mx-auto px-4 sm:px-6 lg:px-8 relative z-10 py-32 lg:py-0">
    <div
      id="hero-canvas-wrapper"
      class="absolute overflow-hidden rounded-3xl pointer-events-none"
      style="inset: -6%; z-index: 0; opacity: 0.4; mask-image: radial-gradient(ellipse 88% 88% at 50% 50%, black 45%, transparent 100%); -webkit-mask-image: radial-gradient(ellipse 88% 88% at 50% 50%, black 45%, transparent 100%);"
    >
      <canvas id="hero-canvas" style="display:block;width:100%;height:100%;"></canvas>
    </div>

    <div
      class="hero-layout grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-12 items-center min-h-screen lg:min-h-0 lg:py-32"
    >
      <div class="order-2 lg:order-1 space-y-6 relative">
        <p class="text-sm font-semibold tracking-widest text-highlight uppercase reveal">
          Backend systems · Platform reliability
        </p>

        <div class="reveal text-backdrop hero-headline-panel" style="transition-delay: 0.1s;">
          <h1 class="font-bold leading-tight" style="font-size: clamp(2.5rem, 5vw, 4.5rem);">
            Hi, I'm<br />
            <span class="gradient-text">{personalData.name}</span>
          </h1>

          <h2 class="text-slate-400 font-light mt-3" style="font-size: clamp(1rem, 2.2vw, 1.5rem);">
            {
              heroParts.length > 1 ? (
                <>
                  {heroParts[0]}{' '}<span class="text-highlight">&</span>{' '}
                  {heroParts.slice(1).join(' & ')}
                </>
              ) : (
                heroParts[0]
              )
            }
          </h2>
        </div>

        <p
          class="text-base text-slate-400 max-w-lg leading-relaxed reveal text-backdrop hero-copy-panel"
          style="transition-delay: 0.2s;"
        >
          {personalData.bio}
        </p>

        <div class="flex flex-col sm:flex-row gap-4 reveal" style="transition-delay: 0.3s;">
          <a href="#projects" class="btn-primary text-center">View Projects</a>
          <a href="#contact" class="btn-secondary text-center">Get In Touch</a>
        </div>

        <div class="flex items-center gap-6 reveal" style="transition-delay: 0.4s;">
          {
            heroSocialLinks.map((link) => (
              <a
                href={link.url}
                target="_blank"
                rel="noopener noreferrer"
                class={`hero-social-link hero-social-link--${link.key}`}
                aria-label={link.label}
              >
                <iconify-icon
                  icon={link.icon}
                  width="24"
                  height="24"
                  aria-hidden="true"
                  style={link.key !== 'github' && link.color ? `color: ${link.color};` : undefined}
                />
              </a>
            ))
          }
        </div>
      </div>

      <div
        class="order-1 lg:order-2 flex justify-center lg:justify-end reveal"
        style="transition-delay: 0.2s;"
      >
        <div class="hero-photo-wrap">
          <img
            src={withBase(personalData.heroPhoto)}
            alt={personalData.heroPhotoAlt}
            class="hero-photo"
            width="1536"
            height="864"
          />
          <div class="hero-photo-scrim" aria-hidden="true"></div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-social-link {
    color: #64748b;
    display: inline-flex;
    align-items: center;
    border-radius: 0.125rem;
    transition:
      color 0.2s ease,
      transform 0.2s ease;
  }
  .hero-social-link:hover {
    color: white;
    transform: translateY(-4px);
  }
  .hero-social-link--github {
    color: #a78bfa;
  }
  .hero-social-link--github:hover {
    color: #c4b5fd;
  }
  .hero-social-link:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  :global([data-theme='light']) .hero-social-link {
    color: #475569;
  }
  :global([data-theme='light']) .hero-social-link:hover {
    color: #1e293b;
  }
  :global([data-theme='light']) .hero-social-link--github,
  :global([data-theme='light']) .hero-social-link--github:hover {
    color: #181717;
  }

  .spotlight-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .spotlight {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
  }

  .spotlight-1 {
    width: 90vw;
    height: 90vw;
    max-width: 900px;
    max-height: 900px;
    background: radial-gradient(circle, rgba(99, 102, 241, 0.09) 0%, transparent 65%);
    filter: blur(24px);
    animation: drift-1 22s ease-in-out infinite alternate;
  }

  .spotlight-2 {
    width: 70vw;
    height: 70vw;
    max-width: 700px;
    max-height: 700px;
    background: radial-gradient(circle, rgba(14, 165, 233, 0.07) 0%, transparent 65%);
    filter: blur(36px);
    animation: drift-2 28s ease-in-out infinite alternate;
  }

  .spotlight-3 {
    width: 40vw;
    height: 40vw;
    max-width: 400px;
    max-height: 400px;
    background: radial-gradient(circle, rgba(139, 92, 246, 0.08) 0%, transparent 60%);
    filter: blur(12px);
    animation: drift-3 18s ease-in-out infinite alternate;
  }

  @keyframes drift-1 {
    0% {
      transform: translate(-20%, -10%);
      opacity: 0.5;
    }
    25% {
      transform: translate(40%, 10%);
      opacity: 1;
    }
    50% {
      transform: translate(60%, 50%);
      opacity: 0.6;
    }
    75% {
      transform: translate(10%, 70%);
      opacity: 0.9;
    }
    100% {
      transform: translate(-10%, 40%);
      opacity: 0.4;
    }
  }

  @keyframes drift-2 {
    0% {
      transform: translate(80%, 60%);
      opacity: 0.6;
    }
    33% {
      transform: translate(10%, 80%);
      opacity: 1;
    }
    66% {
      transform: translate(-10%, 20%);
      opacity: 0.5;
    }
    100% {
      transform: translate(70%, -10%);
      opacity: 0.8;
    }
  }

  @keyframes drift-3 {
    0% {
      transform: translate(50%, 20%);
      opacity: 0.3;
    }
    40% {
      transform: translate(80%, 60%);
      opacity: 0.8;
    }
    70% {
      transform: translate(20%, 80%);
      opacity: 0.4;
    }
    100% {
      transform: translate(60%, 10%);
      opacity: 0.9;
    }
  }

  .hero-photo-wrap {
    position: relative;
    width: min(88vw, 420px);
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 1.75rem;
    -webkit-mask-image: linear-gradient(to bottom, black 72%, transparent 100%);
    mask-image: linear-gradient(to bottom, black 72%, transparent 100%);
  }

  .hero-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 68% 40%;
  }

  .hero-photo-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent 55%, var(--bg) 100%);
    opacity: 0.6;
    pointer-events: none;
  }

  :global([data-theme='light']) .hero-photo-scrim {
    opacity: 0.35;
  }

  @media (min-width: 1024px) {
    /* Fill the grid column so the space between the text and the photo is just the
       grid gap -- never slack from a capped width, never overflow into the text panel. */
    .hero-photo-wrap {
      width: 100%;
      max-width: 700px;
      aspect-ratio: 3 / 2;
      -webkit-mask-image: linear-gradient(to right, transparent 0%, black 34%);
      mask-image: linear-gradient(to right, transparent 0%, black 34%);
    }

    .hero-photo-scrim {
      background: linear-gradient(to right, var(--bg) 0%, transparent 55%);
    }
  }

  .text-backdrop {
    position: relative;
    z-index: 2;
    background: rgba(2, 6, 23, 0.72);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    border-radius: 0.6rem;
    padding: 0.75rem 1rem;
    border-left: 2px solid rgba(96, 165, 250, 0.1);
  }

  :global([data-theme='light']) .text-backdrop {
    color: #1e293b;
    background:
      linear-gradient(135deg, rgba(255, 255, 255, 0.94), rgba(239, 246, 255, 0.82)),
      repeating-linear-gradient(
        0deg,
        rgba(37, 99, 235, 0.035) 0,
        rgba(37, 99, 235, 0.035) 1px,
        transparent 1px,
        transparent 12px
      );
    border: 1px solid rgba(37, 99, 235, 0.16);
    border-left: 4px solid rgba(14, 165, 233, 0.64);
    box-shadow:
      0 20px 50px rgba(37, 99, 235, 0.09),
      inset 0 1px 0 rgba(255, 255, 255, 0.95);
  }

  :global([data-theme='light']) .hero-headline-panel {
    border-radius: 0.85rem;
  }

  :global([data-theme='light']) .hero-headline-panel::after {
    content: '';
    position: absolute;
    right: 1rem;
    bottom: 0.85rem;
    width: 5.25rem;
    height: 0.45rem;
    background: linear-gradient(90deg, rgba(14, 165, 233, 0.45), rgba(79, 70, 229, 0.65));
    border-radius: 999px;
    opacity: 0.75;
    pointer-events: none;
  }

  :global([data-theme='light']) .hero-copy-panel {
    background:
      linear-gradient(135deg, rgba(255, 255, 255, 0.88), rgba(248, 250, 252, 0.76)),
      repeating-linear-gradient(
        90deg,
        rgba(14, 165, 233, 0.035) 0,
        rgba(14, 165, 233, 0.035) 1px,
        transparent 1px,
        transparent 14px
      );
    border-left-color: rgba(79, 70, 229, 0.46);
    color: #334155;
    box-shadow: 0 16px 38px rgba(15, 23, 42, 0.08);
  }

  :global([data-theme='light']) .hero-headline-panel h1 {
    color: #172033;
  }

  :global([data-theme='light']) .hero-headline-panel h2 {
    color: #475569;
  }

  @media (max-width: 639px) {
    :global(#home) {
      min-height: auto;
      align-items: flex-start;
    }

    .hero-shell {
      padding-top: 2rem !important;
      padding-bottom: 3rem !important;
    }

    .hero-layout {
      min-height: auto !important;
      gap: 2rem !important;
    }
  }

  @media (max-width: 1023px) {
    #home p.text-sm.tracking-widest.text-highlight.uppercase {
      display: none;
    }

    #home {
      padding-top: 3rem;
    }

    #home .grid {
      align-content: start;
      gap: 2.5rem;
      min-height: auto;
      padding-top: 1rem;
      padding-bottom: 4rem;
    }

    #home .order-1 {
      margin-top: 0;
      margin-bottom: 0;
    }

    #home .order-2 {
      margin-top: 0;
    }
  }

  :global([data-theme='light']) .gradient-text {
    background: linear-gradient(90deg, #716ae3, #4984a2, #716ae3);
    background-size: 200% auto;
    -webkit-background-clip: text;
    background-clip: text;
    animation: gradient-shift 5s linear infinite;
  }

</style>

<script>
  document.querySelectorAll('#home .reveal').forEach((el) => {
    const io = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          el.classList.add('visible');
          io.disconnect();
        }
      },
      { threshold: 0.05 }
    );
    io.observe(el);
  });

  const canvas = document.getElementById('hero-canvas') as HTMLCanvasElement | null;
  const wrapper = document.getElementById('hero-canvas-wrapper') as HTMLElement | null;
  const section = document.getElementById('home') as HTMLElement | null;
  if (!canvas || !wrapper || !section) {
    console.error('Hero canvas init failed');
  } else {
    const ctx = canvas.getContext('2d')!;
    const BLOCK = 8; // fine grid cell size
    const DOT = 2; // dot diameter in px
    const COLOR_A = '#6366f1';
    const COLOR_B = '#38bdf8';
    const GRID_BG = '#09090b';
    const GRID_STROKE = '#111827';
    const DECAY = 1 / 14;

    let cols = 0,
      rows = 0;

    let timers = new Float32Array(0);

    function resize() {
      const w = wrapper!.offsetWidth;
      const h = wrapper!.offsetHeight;
      canvas!.width = w;
      canvas!.height = h;
      cols = Math.ceil(w / BLOCK) + 1;
      rows = Math.ceil(h / BLOCK) + 1;
      timers = new Float32Array(cols * rows);
    }

    function drawGrid() {
      ctx.fillStyle = GRID_BG;
      ctx.fillRect(0, 0, canvas!.width, canvas!.height);
      ctx.strokeStyle = GRID_STROKE;
      ctx.lineWidth = 0.4;
      for (let x = 0; x <= canvas!.width; x += BLOCK) {
        ctx.beginPath();
        ctx.moveTo(x + 0.5, 0);
        ctx.lineTo(x + 0.5, canvas!.height);
        ctx.stroke();
      }
      for (let y = 0; y <= canvas!.height; y += BLOCK) {
        ctx.beginPath();
        ctx.moveTo(0, y + 0.5);
        ctx.lineTo(canvas!.width, y + 0.5);
        ctx.stroke();
      }
    }

    function drawDot(col: number, row: number, t: number) {
      const cx = col * BLOCK + BLOCK / 2;
      const cy = row * BLOCK + BLOCK / 2;
      const color = (col + row) % 2 === 0 ? COLOR_A : COLOR_B;
      ctx.globalAlpha = t * 0.72;
      ctx.fillStyle = color;
      ctx.fillRect(Math.floor(cx - DOT / 2), Math.floor(cy - DOT / 2), DOT, DOT);
      ctx.globalAlpha = 1.0;
    }

    function animate() {
      drawGrid();
      for (let i = 0; i < timers.length; i++) {
        if (timers[i] > 0) {
          drawDot(i % cols, Math.floor(i / cols), timers[i]);
          timers[i] = Math.max(0, timers[i] - DECAY);
        }
      }
    }

    section.addEventListener('mousemove', (e: MouseEvent) => {
      if (mql.matches || !heroVisible) return;
      const rect = wrapper!.getBoundingClientRect();
      const mx = e.clientX - rect.left;
      const my = e.clientY - rect.top;
      const cx = Math.floor(mx / BLOCK);
      const cy = Math.floor(my / BLOCK);
      const radius = 2;
      for (let dy = -radius; dy <= radius; dy++) {
        for (let dx = -radius; dx <= radius; dx++) {
          if (dx * dx + dy * dy > radius * radius) continue;
          const nx = cx + dx,
            ny = cy + dy;
          if (nx >= 0 && nx < cols && ny >= 0 && ny < rows) {
            const idx = ny * cols + nx;
            if (timers[idx] === 0) timers[idx] = 1.0;
          }
        }
      }
      startAnimation();
    });

    const ro = new ResizeObserver(() => resize());
    ro.observe(wrapper);
    resize();

    const mql = window.matchMedia('(prefers-reduced-motion: reduce)');
    let rafId = 0;
    let heroVisible = true;

    // Self-terminating loop: the rAF cycle stops as soon as all dot timers reach 0,
    // so the canvas draws nothing and burns no CPU when the user's cursor is idle.
    function startAnimation() {
      if (rafId !== 0) return;
      function loop() {
        animate();
        let anyActive = false;
        for (let i = 0; i < timers.length; i++) {
          if (timers[i] > 0) {
            anyActive = true;
            break;
          }
        }
        rafId = anyActive ? requestAnimationFrame(loop) : 0;
      }
      rafId = requestAnimationFrame(loop);
    }

    drawGrid();

    mql.addEventListener('change', (e: MediaQueryListEvent) => {
      if (e.matches) {
        cancelAnimationFrame(rafId);
        rafId = 0;
        drawGrid();
      }
    });

    new IntersectionObserver(
      ([entry]) => {
        heroVisible = entry.isIntersecting;
        if (!entry.isIntersecting) {
          cancelAnimationFrame(rafId);
          rafId = 0;
        }
      },
      { threshold: 0.05 }
    ).observe(section);
  }
</script>
